# Backend environment variables for Secure CRM (FastAPI)

# Database connection (not used by in-memory stub, reserved for future)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crm

# JWT secrets and expiries (mocked in current stub)
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_MIN=43200

# CORS and WebSocket origins
CORS_ALLOWED_ORIGINS=*
WEBSOCKET_ALLOWED_ORIGINS=*

# Migrations flag (reserved)
ENABLE_MIGRATIONS=false

# Webhook secrets
EMAIL_WEBHOOK_SECRET=replace-with-provider-hmac-secret

# Feature flags
FEATURE_REPORTS_ENABLED=true
