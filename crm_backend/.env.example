# Required configuration for backend (do NOT commit secrets to VCS)
# Copy this file to .env and fill the values.

# PostgreSQL async URL (asyncpg driver)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/crm
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# JWT secret (placeholder for demo)
JWT_SECRET=change-me

# Comma-separated CORS origins; default allows React dev server
# Include your deployed frontend origin as well to avoid CORS errors.
# Example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://vscode-internal-35219-beta.beta01.cloud.kavia.ai:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Legacy fallback variables some environments may set:
ALLOWED_ORIGINS=
FRONTEND_URL=

# Enable running migrations on startup (reserved switch)
ENABLE_MIGRATIONS=false
