# Backend Environment Example for Secure CRM

# Database (asyncpg URL) - required for real DB connectivity
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# JWT settings (use strong secrets in production!)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_MIN=43200

# CORS / Frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# FRONTEND_URL=https://your-frontend.example.com:3000

# Optional: run migrations on startup
ENABLE_MIGRATIONS=false
