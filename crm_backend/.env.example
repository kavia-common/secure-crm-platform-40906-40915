# Example environment configuration for crm_backend container

# Application network configuration
APP_HOST=0.0.0.0
APP_PORT=3001

# Database connection configuration (used by the backend via environment only)
# Prefer these CRM_* variables; DB_* can also be used as fallback
CRM_DB_HOST=crm_database
CRM_DB_PORT=5432
CRM_DB_NAME=crm
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=crm_password
