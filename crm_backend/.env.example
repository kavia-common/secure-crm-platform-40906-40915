# Example environment variables for CRM Backend
# Copy to .env and adjust values for your environment.

# App server
APP_HOST=0.0.0.0
APP_PORT=3001

# Database connection (env-only; no file path coupling)
CRM_DB_HOST=crm_database
CRM_DB_PORT=5432
CRM_DB_NAME=crm
CRM_DB_USER=crm_admin
CRM_DB_PASSWORD=change_me_strong

# CORS configuration (adjust as needed)
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
