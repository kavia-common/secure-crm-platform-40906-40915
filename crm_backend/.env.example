# Example environment configuration for CRM Backend

# Database (optional for demo)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/crm

# JWT settings
JWT_SECRET=dev-secret
JWT_REFRESH_SECRET=dev-refresh-secret
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_MIN=43200
JWT_ALGORITHM=HS256

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=

# Feature flags
ENABLE_MIGRATIONS=false

# Auth: test login bypass (development convenience)
# When true, POST /api/v1/auth/login will accept username/email 'test@gmail.com' with any password,
# issue valid JWTs, and /api/v1/auth/me will return a mock profile including this email.
AUTH_ALLOW_TEST_USER=true
TEST_USER_EMAIL=test@gmail.com
TEST_USER_ID=test_user_id
